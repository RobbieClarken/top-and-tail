#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = []
# ///
"""Strip leading and trailing silence from MP3 files without re-encoding."""

import argparse
import os
import shutil
import stat
import subprocess
import sys
import tempfile
from array import array
from collections.abc import Callable, Iterator, Sequence
from dataclasses import dataclass
from pathlib import Path

# Full scale for the signed 16-bit samples ffmpeg decodes for us.
_FULL_SCALE = 32768

# Sources are decoded to mono at this rate purely for amplitude analysis; the
# audio that actually gets written is copied frame for frame from the source.
ANALYSIS_RATE = 44100

DEFAULT_THRESHOLD_DB = -50.0
DEFAULT_MIN_SILENCE = 0.1
DEFAULT_PADDING = 0.050

# An MP3 frame at the analysis rate: the granularity a cut can land on.
FRAME_DURATION = 1152 / ANALYSIS_RATE

# ffmpeg decodes and copies frames; ffprobe supplies the reported durations.
REQUIRED_TOOLS = ("ffmpeg", "ffprobe")


def _as_argument(path: Path) -> str:
    """Render a path for a command line, always absolute.

    Applied to every path handed to ffmpeg or ffprobe. ffprobe takes its input
    as a positional argument, so a relative name beginning with a dash is
    parsed as an option — `-dash.mp3` fails with "Missing argument for option".
    An absolute path can never start with one.
    """
    return str(path.absolute())


class Failure(Exception):
    """A problem with one source, reported to the user without a stack trace."""


def _quiet_limit(threshold_db: float) -> float:
    """The largest sample magnitude that still counts as quiet."""
    return float(_FULL_SCALE * 10.0 ** (threshold_db / 20.0))


def _quiet_runs(
    samples: Sequence[int], limit: float
) -> Iterator[tuple[int, int]]:
    """Yield the half-open bounds of every maximal run of quiet samples."""
    start = None
    for index, sample in enumerate(samples):
        if abs(sample) < limit:
            if start is None:
                start = index
        elif start is not None:
            yield start, index
            start = None
    if start is not None:
        yield start, len(samples)


def find_bounds(
    samples: Sequence[int],
    *,
    sample_rate: int,
    threshold_db: float,
    min_silence: float,
    padding: float,
) -> tuple[float, float] | None:
    """Locate the utterance, plus padding, within a buffer of samples.

    Returns a (start, end) pair in seconds, or None when the buffer holds no
    utterance at all. Only the leading and trailing silence are candidates for
    stripping — quiet anywhere else is internal silence and is left alone.

    Sound is judged by the same yardstick as quiet: just as quiet shorter than
    the minimum silence run is not silence, a stretch of sound shorter than it,
    cut off from the rest by silence, is an artifact rather than part of the
    utterance. Without that rule a single click at the end of a file — or a
    decoder ringing on the final frame — hides all the silence in front of it.
    """
    total = len(samples)
    if not total:
        return None

    limit = _quiet_limit(threshold_db)
    min_samples = round(min_silence * sample_rate)
    pad_samples = round(padding * sample_rate)

    silences = [
        run
        for run in _quiet_runs(samples, limit)
        if run[1] - run[0] >= min_samples
    ]

    # The silences cut the buffer into chunks of material. Chunks long enough
    # to be part of the utterance anchor it; the short ones are artifacts, and
    # any number of them can be shed from either end. Judging every chunk at
    # once — rather than peeling one off each edge — is what keeps a second
    # run from finding yet another artifact to strip.
    edges = [0]
    for silence in silences:
        edges.extend(silence)
    edges.append(total)
    chunks = [(edges[i], edges[i + 1]) for i in range(0, len(edges), 2)]

    utterance = [chunk for chunk in chunks if chunk[1] - chunk[0] >= min_samples]
    if not utterance:
        return None

    start = max(utterance[0][0] - pad_samples, 0)
    end = min(utterance[-1][1] + pad_samples, total)
    return start / sample_rate, end / sample_rate


def decode(source: Path) -> "array[int]":
    """Decode a source to mono 16-bit samples for analysis."""
    try:
        result = subprocess.run(
            [
                "ffmpeg", "-v", "error", "-i", _as_argument(source),
                "-ac", "1", "-ar", str(ANALYSIS_RATE), "-f", "s16le", "-",
            ],
            capture_output=True,
            check=True,
        )
    except subprocess.CalledProcessError as error:
        raise Failure("not a readable MP3") from error
    samples = array("h", result.stdout)
    if sys.byteorder == "big":
        samples.byteswap()
    return samples


def probe_duration(path: Path) -> float:
    """The container duration, as ffprobe and every player report it.

    Deliberately not the decoded sample count: after a cut the two disagree,
    because the gapless-playback info in the Xing header changes. Measuring
    both ends of a report the same way is what stops a re-run of an already
    stripped file claiming the file grew.
    """
    try:
        result = subprocess.run(
            [
                "ffprobe", "-v", "error",
                "-show_entries", "format=duration",
                "-of", "default=noprint_wrappers=1:nokey=1",
                _as_argument(path),
            ],
            capture_output=True,
            text=True,
            check=True,
        )
    except subprocess.CalledProcessError as error:
        raise Failure("not a readable MP3") from error
    try:
        return float(result.stdout.strip())
    except ValueError as error:
        raise Failure("its duration could not be read") from error


def copy_frames(
    source: Path, destination: Path, start: float, end: float
) -> None:
    """Copy the frames between start and end into the destination.

    Frames are copied, never re-encoded, so the retained audio is
    bit-identical to the source. Cut points quantise to the frame size.

    ID3 tags are carried across, with one unavoidable exception: the mp3
    muxer always stamps its own `encoder` tag, and neither -bitexact (which
    drops every tag) nor an explicit -metadata override prevents it.
    """
    try:
        subprocess.run(
            [
                "ffmpeg", "-v", "error", "-y",
                "-ss", f"{start:.6f}", "-to", f"{end:.6f}",
                "-i", _as_argument(source),
                "-c", "copy", "-map_metadata", "0",
                _as_argument(destination),
            ],
            capture_output=True,
            check=True,
        )
    except subprocess.CalledProcessError as error:
        raise Failure("ffmpeg could not copy its frames") from error


def copy_bytes(source: Path, destination: Path) -> None:
    """Copy a source verbatim, for when there is nothing to strip."""
    shutil.copyfile(source, destination)


def is_same_file(source: Path, destination: Path) -> bool:
    """Whether both names refer to one file — identity, symlink or hard link."""
    return destination.exists() and destination.samefile(source)


def _unwritable(destination: Path, error: OSError) -> Failure:
    return Failure(f"cannot write {destination}: {error.strerror or error}")


def place(
    source: Path, destination: Path, produce: Callable[[Path], None]
) -> None:
    """Build the destination's contents via a temporary file, then rename.

    Every write goes through here — stripped results and exact copies alike —
    so both obey one set of rules. The temporary lives in the destination's own
    directory, so the rename stays on one filesystem and is therefore atomic.
    An interrupted run leaves the destination as it was rather than truncated,
    which is what makes it safe for a destination to be its own source.
    """
    # mkstemp creates at 0600, and the rename would carry that onto the
    # destination — silently making a 0644 file owner-only. Keep whatever mode
    # the destination already had, or failing that the source's.
    try:
        existing = destination if destination.exists() else source
        mode = stat.S_IMODE(existing.stat().st_mode)
        handle, path = tempfile.mkstemp(dir=destination.parent, suffix=".mp3")
    except OSError as error:
        raise _unwritable(destination, error) from error

    os.close(handle)
    scratch = Path(path)
    try:
        try:
            produce(scratch)
            scratch.chmod(mode)
            os.replace(scratch, destination)
        except OSError as error:
            raise _unwritable(destination, error) from error
    except BaseException:
        # The outer net is deliberately broad: the temporary must not survive a
        # KeyboardInterrupt either. Only on the failure path, since after a
        # successful rename the name is gone and could have been reused.
        scratch.unlink(missing_ok=True)
        raise


@dataclass(frozen=True)
class Outcome:
    """What stripping did to one source, or to a whole batch."""

    label: str
    before: float
    after: float
    unchanged: bool = False

    @classmethod
    def for_source(
        cls, source: Path, before: float, after: float, *, unchanged: bool = False
    ) -> "Outcome":
        return cls(
            label=source.name, before=before, after=after, unchanged=unchanged
        )

    @classmethod
    def total(cls, outcomes: Sequence["Outcome"]) -> "Outcome":
        return cls(
            label=f"{len(outcomes)} files",
            before=sum(outcome.before for outcome in outcomes),
            after=sum(outcome.after for outcome in outcomes),
            unchanged=all(outcome.unchanged for outcome in outcomes),
        )

    @property
    def change(self) -> float:
        """Fractional change in duration, negative when silence was removed."""
        if not self.before:
            return 0.0
        return (self.after - self.before) / self.before

    def __str__(self) -> str:
        # Reported rather than hidden, so a repeat run visibly confirms that
        # the tool is idempotent instead of looking like it did nothing.
        if self.unchanged:
            return f"{self.label}  {self.before:.2f}s  unchanged"
        # The sign is always explicit: a file that somehow grew must not read
        # like one that shrank by the same amount.
        return (
            f"{self.label}  "
            f"{self.before:.2f}s → {self.after:.2f}s  "
            f"({self.change * 100:+.0f}%)"
        )


def keep_unchanged(source: Path, destination: Path) -> None:
    """Leave an unstrippable source alone, but still produce the destination.

    Writing the destination keeps a batch's output set complete regardless of
    which sources needed work. The exception is when the destination already
    is the source: rewriting it with identical bytes would bump the mtime and
    wake every file watcher for no reason.
    """
    if is_same_file(source, destination):
        return
    place(source, destination, lambda scratch: copy_bytes(source, scratch))


def check_writable(destination: Path) -> None:
    """Whether a real run could write here, without writing anything.

    A dry run never touches the destination, so it would otherwise report
    success for a run that is certain to fail — exactly the case the preview
    exists to catch.
    """
    parent = destination.parent
    if not parent.is_dir():
        raise Failure(f"cannot write {destination}: No such directory")
    if not os.access(parent, os.W_OK):
        raise Failure(f"cannot write {destination}: Permission denied")


def duration_if_stripped(source: Path, start: float, end: float) -> float:
    """How long the result would be, without writing anything the user sees.

    The cut is performed for real, into the system temporary directory rather
    than beside the destination, so the reported duration is the one a real run
    would produce — frame rounding included — while leaving no trace in the
    user's own directories for a file watcher to notice.
    """
    with tempfile.TemporaryDirectory() as scratch_dir:
        scratch = Path(scratch_dir) / "preview.mp3"
        copy_frames(source, scratch, start, end)
        return probe_duration(scratch)


def strip(
    source: Path,
    destination: Path,
    *,
    threshold_db: float,
    min_silence: float,
    padding: float,
    dry_run: bool,
) -> Outcome:
    before = probe_duration(source)
    samples = decode(source)
    found = find_bounds(
        samples,
        sample_rate=ANALYSIS_RATE,
        threshold_db=threshold_db,
        min_silence=min_silence,
        padding=padding,
    )

    # Nothing to strip covers two cases: a source that is silent throughout,
    # which must be preserved rather than truncated to nothing, and one whose
    # quiet is too brief to be silence.
    whole = len(samples) / ANALYSIS_RATE
    if found is None or found == (0.0, whole):
        if dry_run:
            # A real run would copy the source across, unless it is already
            # sitting at the destination.
            if not is_same_file(source, destination):
                check_writable(destination)
        else:
            keep_unchanged(source, destination)
        return Outcome.for_source(source, before, before, unchanged=True)

    start, end = found
    if dry_run:
        check_writable(destination)
        after = duration_if_stripped(source, start, end)
        return Outcome.for_source(source, before, after)

    place(
        source,
        destination,
        lambda scratch: copy_frames(source, scratch, start, end),
    )

    # Measured from the written file rather than from the bounds we asked for,
    # so the report states what is actually on disk after frame rounding.
    return Outcome.for_source(source, before, probe_duration(destination))


def settings_error(min_silence: float, padding: float) -> str | None:
    """Why these settings would break idempotency, or None if they are safe.

    After a strip the quiet left at each end is the padding plus up to a frame
    of rounding. If that residue is long enough to count as silence next time,
    every re-run eats another slice of the utterance. See ADR-0001.
    """
    floor = padding + FRAME_DURATION
    if min_silence <= floor:
        return (
            f"--min-silence must exceed --padding plus one {FRAME_DURATION * 1000:.1f}ms "
            f"frame, so more than {floor:.4f}s, or repeated runs would keep "
            f"stripping; got {min_silence}s"
        )
    return None


def check_source(source: Path) -> None:
    """Reject an unusable source by naming what is actually wrong with it."""
    if not source.exists():
        raise Failure("broken symlink" if source.is_symlink() else "no such file")
    if not source.is_file():
        raise Failure("not a regular file")
    if not os.access(source, os.R_OK):
        raise Failure("not readable")


def destination_for(
    source: Path, *, in_place: bool, named: Path | None
) -> Path:
    """Where one source's result should be written.

    Always resolved, so a destination reached through a symlink is recognised
    as the file it points at. Without that, writing to a link that points at
    the source would replace the link and leave the source untouched.
    """
    if in_place:
        return source.resolve()
    if named is not None:
        return named.resolve()
    return source.with_suffix(".stripped.mp3").resolve()


def usage_error(message: str) -> int:
    """Report a problem that stops the run before it starts."""
    print(message, file=sys.stderr)
    return 2


def strip_all(
    sources: Sequence[Path],
    *,
    in_place: bool,
    named: Path | None,
    threshold_db: float,
    min_silence: float,
    padding: float,
    dry_run: bool,
) -> tuple[list[Outcome], int]:
    """Strip every source, reporting as it goes. Returns outcomes and failures.

    One bad source must not stop the rest of the batch: a single failed
    download should not block everything generated alongside it.
    """
    outcomes = []
    failures = 0
    for source in sources:
        try:
            check_source(source)
            outcome = strip(
                source,
                destination_for(source, in_place=in_place, named=named),
                threshold_db=threshold_db,
                min_silence=min_silence,
                padding=padding,
                dry_run=dry_run,
            )
        except Failure as failure:
            print(f"{source}: {failure}", file=sys.stderr)
            failures += 1
            continue
        print(outcome)
        outcomes.append(outcome)
    return outcomes, failures


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Strip leading and trailing silence from MP3 files.",
    )
    parser.add_argument("sources", nargs="+", type=Path, metavar="source")
    # Deliberately no -i short form: it means *input* in ffmpeg and most audio
    # tooling, and here it would silently overwrite the source.
    destinations = parser.add_mutually_exclusive_group()
    destinations.add_argument(
        "--in-place",
        action="store_true",
        help="replace each source with its stripped result",
    )
    destinations.add_argument(
        "-o",
        "--output",
        type=Path,
        help="write the result to this path (one source only)",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="report what would happen without writing anything",
    )
    parser.add_argument(
        "--threshold",
        type=float,
        default=DEFAULT_THRESHOLD_DB,
        metavar="DBFS",
        help=f"below this amplitude counts as quiet (default {DEFAULT_THRESHOLD_DB})",
    )
    parser.add_argument(
        "--min-silence",
        type=float,
        default=DEFAULT_MIN_SILENCE,
        metavar="SECONDS",
        help=f"how long quiet must last to be silence (default {DEFAULT_MIN_SILENCE})",
    )
    parser.add_argument(
        "--padding",
        type=float,
        default=DEFAULT_PADDING,
        metavar="SECONDS",
        help=f"silence kept at each end (default {DEFAULT_PADDING})",
    )
    args = parser.parse_args(argv)

    # Checked once, up front: without these nothing can succeed, and repeating
    # the same message for every source would be noise.
    missing = [name for name in REQUIRED_TOOLS if shutil.which(name) is None]
    if missing:
        return usage_error(
            f"{' and '.join(missing)} not found on PATH — "
            f"top-and-tail needs ffmpeg and ffprobe, which ship together"
        )

    # Checked before any source is read: a combination that would erode audio
    # on every run must fail loudly rather than quietly.
    problem = settings_error(args.min_silence, args.padding)
    if problem:
        return usage_error(problem)

    # Sources are explicit file paths. Directories are never walked, so being
    # handed one is a usage error rather than something to recurse into.
    directories = [source for source in args.sources if source.is_dir()]
    if directories:
        return usage_error(
            "\n".join(
                f"{directory}: is a directory — pass explicit file paths"
                for directory in directories
            )
        )

    # One named destination cannot hold several results, and silently letting
    # the last source win would lose the others.
    if args.output is not None and len(args.sources) > 1:
        return usage_error(
            f"-o/--output names a single destination, "
            f"but {len(args.sources)} sources were given"
        )

    outcomes, failures = strip_all(
        args.sources,
        in_place=args.in_place,
        named=args.output,
        threshold_db=args.threshold,
        min_silence=args.min_silence,
        padding=args.padding,
        dry_run=args.dry_run,
    )

    # A summary that merely restates the single line above it is noise — which
    # applies to the failure count just as much as to the totals.
    if len(outcomes) > 1:
        print(Outcome.total(outcomes))
    if failures and len(args.sources) > 1:
        print(f"{failures} of {len(args.sources)} sources failed", file=sys.stderr)
    if args.dry_run:
        print("dry run — nothing was written")

    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
