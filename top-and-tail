#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = []
# ///
"""Strip leading and trailing silence from MP3 files without re-encoding."""

import argparse
import os
import subprocess
import sys
import tempfile
from array import array
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path

# Full scale for the signed 16-bit samples ffmpeg decodes for us.
_FULL_SCALE = 32768

# Sources are decoded to mono at this rate purely for amplitude analysis; the
# audio that actually gets written is copied frame for frame from the source.
ANALYSIS_RATE = 44100

DEFAULT_THRESHOLD_DB = -50.0
DEFAULT_MIN_SILENCE = 0.1
DEFAULT_PADDING = 0.050


def _quiet_limit(threshold_db: float) -> float:
    """The largest sample magnitude that still counts as quiet."""
    return float(_FULL_SCALE * 10.0 ** (threshold_db / 20.0))


def find_bounds(
    samples: Sequence[int],
    *,
    sample_rate: int,
    threshold_db: float,
    min_silence: float,
    padding: float,
) -> tuple[float, float] | None:
    """Locate the utterance, plus padding, within a buffer of samples.

    Returns a (start, end) pair in seconds, or None when the buffer holds no
    utterance at all. Only the leading and trailing silence are candidates for
    stripping — quiet anywhere else is internal silence and is left alone.
    """
    total = len(samples)
    limit = _quiet_limit(threshold_db)

    # Sample indices bounding the audible content: the first audible sample,
    # and the one just past the last.
    utterance_start = 0
    while utterance_start < total and abs(samples[utterance_start]) < limit:
        utterance_start += 1

    if utterance_start == total:
        return None

    utterance_end = total
    while abs(samples[utterance_end - 1]) < limit:
        utterance_end -= 1

    min_samples = round(min_silence * sample_rate)
    pad_samples = round(padding * sample_rate)

    leading_quiet = utterance_start
    trailing_quiet = total - utterance_end

    start = utterance_start - pad_samples if leading_quiet >= min_samples else 0
    end = utterance_end + pad_samples if trailing_quiet >= min_samples else total

    return max(start, 0) / sample_rate, min(end, total) / sample_rate


def decode(source: Path) -> "array[int]":
    """Decode a source to mono 16-bit samples for analysis."""
    result = subprocess.run(
        [
            "ffmpeg", "-v", "error", "-i", str(source),
            "-ac", "1", "-ar", str(ANALYSIS_RATE), "-f", "s16le", "-",
        ],
        capture_output=True,
        check=True,
    )
    samples = array("h", result.stdout)
    if sys.byteorder == "big":
        samples.byteswap()
    return samples


def probe_duration(path: Path) -> float:
    """The container duration, as ffprobe and every player report it.

    Deliberately not the decoded sample count: after a cut the two disagree,
    because the gapless-playback info in the Xing header changes. Measuring
    both ends of a report the same way is what stops a re-run of an already
    stripped file claiming the file grew.
    """
    result = subprocess.run(
        [
            "ffprobe", "-v", "error",
            "-show_entries", "format=duration",
            "-of", "default=noprint_wrappers=1:nokey=1",
            str(path),
        ],
        capture_output=True,
        text=True,
        check=True,
    )
    return float(result.stdout.strip())


def copy_frames(
    source: Path, destination: Path, start: float, end: float
) -> None:
    """Copy the frames between start and end into the destination.

    Frames are copied, never re-encoded, so the retained audio is
    bit-identical to the source. Cut points quantise to the frame size.

    ID3 tags are carried across, with one unavoidable exception: the mp3
    muxer always stamps its own `encoder` tag, and neither -bitexact (which
    drops every tag) nor an explicit -metadata override prevents it.
    """
    subprocess.run(
        [
            "ffmpeg", "-v", "error", "-y",
            "-ss", f"{start:.6f}", "-to", f"{end:.6f}",
            "-i", str(source),
            "-c", "copy", "-map_metadata", "0",
            str(destination),
        ],
        capture_output=True,
        check=True,
    )


def write_atomically(
    source: Path, destination: Path, start: float, end: float
) -> None:
    """Write the stripped result through a temporary file, then rename.

    The temporary lives in the destination's own directory so the rename stays
    on one filesystem and is therefore atomic. An interrupted run leaves the
    destination as it was rather than truncated, which is what makes it safe
    to point a destination at its own source.
    """
    handle, temporary = tempfile.mkstemp(dir=destination.parent, suffix=".mp3")
    os.close(handle)
    scratch = Path(temporary)
    try:
        copy_frames(source, scratch, start, end)
        os.replace(scratch, destination)
    finally:
        scratch.unlink(missing_ok=True)


@dataclass(frozen=True)
class Outcome:
    """What stripping did to one source, or to a whole batch."""

    label: str
    before: float
    after: float

    @classmethod
    def for_source(cls, source: Path, before: float, after: float) -> "Outcome":
        return cls(label=source.name, before=before, after=after)

    @classmethod
    def total(cls, outcomes: Sequence["Outcome"]) -> "Outcome":
        return cls(
            label=f"{len(outcomes)} files",
            before=sum(outcome.before for outcome in outcomes),
            after=sum(outcome.after for outcome in outcomes),
        )

    @property
    def change(self) -> float:
        """Fractional change in duration, negative when silence was removed."""
        if not self.before:
            return 0.0
        return (self.after - self.before) / self.before

    def __str__(self) -> str:
        # The sign is always explicit: a file that somehow grew must not read
        # like one that shrank by the same amount.
        return (
            f"{self.label}  "
            f"{self.before:.2f}s → {self.after:.2f}s  "
            f"({self.change * 100:+.0f}%)"
        )


def strip(
    source: Path,
    destination: Path,
    *,
    threshold_db: float,
    min_silence: float,
    padding: float,
) -> Outcome:
    before = probe_duration(source)
    samples = decode(source)
    found = find_bounds(
        samples,
        sample_rate=ANALYSIS_RATE,
        threshold_db=threshold_db,
        min_silence=min_silence,
        padding=padding,
    )
    # A source with no utterance is kept whole rather than truncated to
    # nothing. Reporting it as unchanged belongs to a later ticket.
    start, end = found if found else (0.0, len(samples) / ANALYSIS_RATE)
    write_atomically(source, destination, start, end)

    # Measured from the written file rather than from the bounds we asked for,
    # so the report states what is actually on disk after frame rounding.
    return Outcome.for_source(source, before, probe_duration(destination))


def default_destination(source: Path) -> Path:
    return source.with_suffix(".stripped.mp3")


def destination_for(source: Path, inplace: bool, output: Path | None) -> Path:
    if inplace:
        return source
    if output is not None:
        return output
    return default_destination(source)


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Strip leading and trailing silence from MP3 files.",
    )
    parser.add_argument("sources", nargs="+", type=Path, metavar="source")
    # Deliberately no -i short form: it means *input* in ffmpeg and most audio
    # tooling, and here it would silently overwrite the source.
    destinations = parser.add_mutually_exclusive_group()
    destinations.add_argument(
        "--inplace",
        action="store_true",
        help="replace each source with its stripped result",
    )
    destinations.add_argument(
        "-o",
        "--output",
        type=Path,
        help="write the result to this path (one source only)",
    )
    args = parser.parse_args(argv)

    # Sources are explicit file paths. Directories are never walked, so being
    # handed one is a usage error rather than something to recurse into.
    directories = [source for source in args.sources if source.is_dir()]
    if directories:
        for directory in directories:
            print(
                f"{directory}: is a directory — pass explicit file paths",
                file=sys.stderr,
            )
        return 2

    # One named destination cannot hold several results, and silently letting
    # the last source win would lose the others.
    if args.output is not None and len(args.sources) > 1:
        print(
            f"-o/--output names a single destination, "
            f"but {len(args.sources)} sources were given",
            file=sys.stderr,
        )
        return 2

    outcomes = []
    for source in args.sources:
        destination = destination_for(source, args.inplace, args.output)
        outcome = strip(
            source,
            destination,
            threshold_db=DEFAULT_THRESHOLD_DB,
            min_silence=DEFAULT_MIN_SILENCE,
            padding=DEFAULT_PADDING,
        )
        print(outcome)
        outcomes.append(outcome)

    # A summary that merely restates the single line above it is noise.
    if len(outcomes) > 1:
        print(Outcome.total(outcomes))
    return 0


if __name__ == "__main__":
    sys.exit(main())
